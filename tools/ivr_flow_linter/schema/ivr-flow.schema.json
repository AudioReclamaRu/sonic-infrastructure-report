{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AudioReclamaRu/sonic-infrastructure-report/blob/main/tools/ivr_flow_linter/schema/ivr-flow.schema.json",
  "title": "IVR Flow Linter input",
  "description": "A declarative graph for static IVR routing checks. This schema does not describe a PBX configuration or guarantee live telephony behavior.",
  "type": "object",
  "required": ["schema_version", "flow_id", "entrypoints", "nodes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "flow_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "entrypoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_operator_escape": {"type": "boolean"},
        "require_timeout_fallback": {"type": "boolean"},
        "require_invalid_input_fallback": {"type": "boolean"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["menu", "message", "terminal"]},
          "prompt_asset": {"type": "string"},
          "transitions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "terminal_kind": {"enum": ["operator", "queue", "voicemail", "hangup", "external_transfer", "other"]}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "terminal"}}, "required": ["type"]}, "then": {"required": ["terminal_kind"]}}
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
