{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AudioReclamaRu/sonic-infrastructure-report/blob/main/tools/ivr_flow_linter/schema/ivr-flow.schema.json",
  "title": "IVR Flow Linter input",
  "description": "A declarative graph for static IVR routing checks. This schema does not describe a PBX configuration or guarantee live telephony behavior.",
  "type": "object",
  "required": [
    "schema_version",
    "flow_id",
    "entrypoints",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "flow_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_operator_escape": {
          "type": "boolean"
        },
        "require_timeout_fallback": {
          "type": "boolean"
        },
        "require_invalid_input_fallback": {
          "type": "boolean"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "menu",
              "message",
              "terminal"
            ]
          },
          "prompt_asset": {
            "type": "string"
          },
          "transitions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "terminal_kind": {
            "enum": [
              "operator",
              "queue",
              "voicemail",
              "hangup",
              "external_transfer",
              "other"
            ]
          },
          "interop_source": {
            "type": "object",
            "required": [
              "application",
              "graph_version",
              "node_kind",
              "metadata_policy",
              "metadata"
            ],
            "properties": {
              "application": {
                "const": "michaelnabil230/asterisk-call-flow-builder"
              },
              "graph_version": {
                "type": "integer",
                "const": 1
              },
              "node_kind": {
                "enum": [
                  "start",
                  "menu",
                  "playback",
                  "extension",
                  "queue",
                  "hangup"
                ]
              },
              "metadata_policy": {
                "const": "kind_whitelist_only"
              },
              "node_type": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "metadata": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "terminal"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "terminal_kind"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_application",
        "source_graph_version",
        "metadata_policy"
      ],
      "properties": {
        "source_application": {
          "const": "michaelnabil230/asterisk-call-flow-builder"
        },
        "source_graph_version": {
          "type": "integer",
          "const": 1
        },
        "asterisk_context": {
          "type": "string"
        },
        "asterisk_trunk": {
          "type": "string"
        },
        "metadata_policy": {
          "const": "kind_whitelist_only"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
