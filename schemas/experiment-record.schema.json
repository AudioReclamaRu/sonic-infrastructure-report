{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AudioReclamaRu/sonic-infrastructure-report/blob/main/schemas/experiment-record.schema.json",
  "title": "Interdisciplinary Experiment Record",
  "description": "Machine-readable record for experiments. The repository validator enforces the critical six-lens and result gates; this file is the interoperable data contract, not a full legal/ethics approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "experiment_id",
    "status",
    "experiment_type",
    "protocol_version",
    "created_at",
    "owner",
    "question",
    "hypothesis",
    "null_hypothesis",
    "falsifier",
    "scope",
    "variables",
    "controls",
    "six_lenses",
    "data_provenance",
    "analysis_plan",
    "external_release"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "const": "experiment"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "PLANNED",
        "RUNNING",
        "HOLD",
        "COMPLETED",
        "REPRODUCED",
        "FAILED"
      ]
    },
    "experiment_type": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "null_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "falsifier": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "operational_definition",
          "unit",
          "measurement_method"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "independent",
              "dependent",
              "control",
              "confounder",
              "uncontrolled"
            ]
          },
          "operational_definition": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "measurement_method": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": "string"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "six_lenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semiotics",
        "ethology_behavior",
        "chronobiology",
        "ergonomics_human_factors",
        "complex_systems",
        "cryptology"
      ],
      "properties": {
        "semiotics": {
          "$ref": "#/$defs/lens"
        },
        "ethology_behavior": {
          "$ref": "#/$defs/lens"
        },
        "chronobiology": {
          "$ref": "#/$defs/lens"
        },
        "ergonomics_human_factors": {
          "$ref": "#/$defs/lens"
        },
        "complex_systems": {
          "$ref": "#/$defs/lens"
        },
        "cryptology": {
          "$ref": "#/$defs/lens"
        }
      }
    },
    "data_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "collection_method",
        "data_classification"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collection_method": {
          "type": "string",
          "minLength": 1
        },
        "raw_data_ref": {
          "type": "string"
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted",
            "sensitive"
          ]
        },
        "hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "digest",
              "object_ref"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": [
                  "SHA-256",
                  "SHA-384",
                  "SHA-512"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]+$"
              },
              "object_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "analysis_plan": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "observations",
        "measurements",
        "limitations",
        "verdict"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "NOT_SUPPORTED",
            "INCONCLUSIVE",
            "CONTRADICTED",
            "HOLD"
          ]
        }
      }
    },
    "hold_reason": {
      "type": "string"
    },
    "external_release": {
      "type": "boolean"
    },
    "release_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_at",
        "approval_ref"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "synthetic_fixture": {
      "type": "boolean",
      "description": "True only for a synthetic fixture/example. Synthetic fixtures cannot be externally released."
    }
  },
  "$defs": {
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "risk",
        "assessment",
        "check",
        "rationale",
        "evidence",
        "hold_reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "NOT_ASSESSED",
            "HOLD"
          ]
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hold_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPLICABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "check": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "rationale": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_ASSESSED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "rationale": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "HOLD"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "hold_reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "COMPLETED",
              "REPRODUCED",
              "FAILED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "started_at",
          "completed_at",
          "results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "HOLD"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "hold_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "external_release": {
            "const": true
          }
        },
        "required": [
          "external_release"
        ]
      },
      "then": {
        "required": [
          "release_approval"
        ],
        "properties": {
          "status": {
            "enum": [
              "COMPLETED",
              "REPRODUCED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "synthetic_fixture": {
            "const": true
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "PROPOSED",
              "PLANNED",
              "HOLD",
              "FAILED"
            ]
          }
        }
      }
    }
  ]
}
