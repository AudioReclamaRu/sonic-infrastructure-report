# Python
__pycache__/
*.pyc

# Runtime state, logs, pid
*.log
state/*.log
state/*.pid
state/logs/
logs/

# Frozen-concept marker: written by publisher.py on the first REJECT, cleared
# when the concept is unfrozen. Absence means "nothing frozen", so it carries no
# information for a clone -> runtime, not tracked.
state/rejected.txt

# Backups of the registry, written by the live loop (originals live in git history)
state/items_phantom_backup_*.csv

# Cover generator backups (old designs; originals live in git history)
feed/images/backup-red-field/

# Any backup/scratch snapshot (originals live in git history); old generator/orchestrator
*.bak-*
feed/image-gen.ps1
post-orchestrator.ps1
feed/cover-brand.json
feed/fb_real_test.txt

# Live loop heartbeat (runtime, rewritten every cycle -> never stage by hand)
state/heartbeat.txt

# Runtime-generated registries / slots (not AI-facing content)
state/design-cards.csv
state/slot-*.text

# Scratch / debug / probe / internal tooling (underscore = internal)
_*
state/_probe*
state/_rt*

# Windows scheduled-task wrappers and launch helpers (infra, not content)
*.vbs
*_task.xml