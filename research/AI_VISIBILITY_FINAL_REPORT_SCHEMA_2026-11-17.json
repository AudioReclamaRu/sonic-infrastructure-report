{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio/ai-visibility-final-report/1",
  "title": "AI Visibility Final Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at_utc", "run", "coverage", "benchmark", "interpretation"],
  "properties": {
    "schema": {"const": "studio/ai-visibility-final-report/1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "lifecycle", "plan_passport_sha256", "result_passport_sha256", "region", "planned_cells", "queue_files", "primary_observation_records"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "lifecycle": {"const": "FINALIZED"},
        "plan_passport_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_passport_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "attestation_id", "attestation_sha256"],
          "properties": {
            "status": {"enum": ["UNVERIFIED", "VERIFIED"]},
            "attestation_id": {"type": ["string", "null"]},
            "attestation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "planned_cells": {"type": "integer", "minimum": 0},
        "queue_files": {"type": "integer", "minimum": 1},
        "primary_observation_records": {"type": "integer", "minimum": 1}
      }
    },
    "coverage": {"type": "object"},
    "benchmark": {
      "type": "object",
      "required": ["schema", "grouping", "answer_statuses_counted_as_answered", "note", "groups"]
    },
    "interpretation": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
