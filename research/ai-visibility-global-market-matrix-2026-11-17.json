      "Russia",
      "CIS and Russian-speaking markets"
    ],
    "worldwide_regions": [
      "Europe",
      "United Kingdom",
      "North America",
      "Australia and New Zealand",
      "Asia",
      "Latin America",
      "Middle East",
      "Africa",
      "other markets with potential demand"
    ],
    "coverage_rule": "The markets below are the first structured sampling wave, not an exhaustive country list. Add further countries and languages when demand, historical customers, service capacity, platform access or useful regional AI coverage justify them. Do not use this seed list to exclude the rest of the world.",
    "language_rule": "Each locale is a separate test cell. A country's dominant language, a customer's language and the platform UI language may differ; store them independently.",
    "serviceability_rule": "A benchmark locale is not a promise that the studio can fulfil every language. Verify voice talent, translation/localization, rights, delivery, payments and contractual feasibility before making a commercial claim."
  },
